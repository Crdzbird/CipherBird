<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.cryptolib.cipherbird">
  <application>
    <!--
      Startup hook: Android instantiates this ContentProvider very early in app
      launch, so its onCreate() warms libcryptolib_c on a background thread
      before the first Dart FFI call. authorities uses ${applicationId} so it is
      unique per host app. Not exported; never queried.
    -->
    <provider
      android:name="com.cryptolib.cipherbird.CipherbirdStartup"
      android:authorities="${applicationId}.cipherbird-startup"
      android:exported="false"
      android:initOrder="100" />
  </application>
</manifest>
