# ───────────────────────── Build outputs ─────────────────────────
build/
build-*/
cmake-build-*/
*.o
*.obj
*.pdb
*.dSYM/

# Compiled / vendored native libraries.
# Regenerated by the build scripts (scripts/build_selfcontained.sh, etc.)
# and shipped as release artifacts — never source-controlled.
*.dylib
*.so
*.so.*
*.dll
*.a
*.lib
*.wasm
*.jar

# WASM build output (regenerated by the emscripten build)
bridge/bindings/cryptolib-wasm/dist/

# Per-binding vendored prebuilt native directories
bridge/bindings/*/native/
bridge/bindings/*/prebuilds/
bridge/bindings/*/out/
bridge/bindings/cryptolib-python/cryptolib/_native/
bridge/bindings/cryptolib-ruby/lib/cryptolib/native/
bridge/bindings/cryptolib-dotnet/runtimes/
bridge/bindings/cryptolib-dotnet/bin/
bridge/bindings/cryptolib-dotnet/obj/

# ──────────── Cross-compiled dependency build outputs ────────────
# Regenerated from the third_party/**/src/*.tar.gz sources by the
# iOS/Android cross-compile scripts. The source tarballs ARE committed.
third_party/android/arm64-v8a/
third_party/android/armeabi-v7a/
third_party/android/x86/
third_party/android/x86_64/
third_party/ios/iphoneos/
third_party/ios/iphonesimulator/
third_party/ios/macosx/
third_party/web/

# Keep the vendored dependency source tarballs; drop unpacked sources.
third_party/ios/src/*
!third_party/ios/src/*.tar.gz
third_party/android/src/*
!third_party/android/src/*.tar.gz

# Final XCFrameworks — regenerated by ./scripts/ios/build_all.sh and
# ./scripts/ios/assemble_xcframework.sh (vendored copies are build artifacts).
CryptoLib.xcframework/
CryptoLibC.xcframework/

# Self-contained Go static archive — regenerated by ./scripts/build_static_archive.sh
build/static/

# ───────────────────────────── Node ──────────────────────────────
node_modules/
*.tsbuildinfo

# ───────────────────────────── Rust ──────────────────────────────
target/

# ──────────────────────────── Python ─────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ────────────────────────────── Go ───────────────────────────────
bridge/go/example
bridge/go/client
bridge/go/server

# ─────────────────────── Swift / SwiftPM ─────────────────────────
.build/
.swiftpm/
Package.resolved

# ───────────────────────────── Xcode ─────────────────────────────
*.xcuserdata/
*.xcuserstate
DerivedData/

# ──────────────────────────── Flutter ────────────────────────────
.dart_tool/
.packages
**/Pods/
bridge/flutter/build/

# ────────────────────────────── IDE ──────────────────────────────
.idea/
.vscode/
*.iml

# ──────────────────────── Scratch / local ────────────────────────
local/

# ────────────────────────────── macOS ────────────────────────────
.DS_Store

# The WebAssembly engine ships inside both Dart packages.
!bridge/bindings/cipherbird/assets/cipherbird.wasm
!bridge/bindings/cipherbird_dart/lib/assets/cipherbird.wasm
